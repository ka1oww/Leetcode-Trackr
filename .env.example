# --- Required ---
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEETCODE_USERNAME=your_leetcode_username

# --- Optional: summary enrichment (bring your own Anthropic or OpenAI key) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
# OPENAI_MODEL defaults to gpt-5.4-nano when left unset
# If the OpenAI API rejects the request with a 400 naming the reasoning
# field (older models do not accept it), the call is retried once without it
OPENAI_MODEL=gpt-5.4-nano

# --- Optional: unlock your submitted code / runtime / memory ---
# Copy the LEETCODE_SESSION cookie from your browser:
# DevTools -> Application -> Cookies -> https://leetcode.com
LEETCODE_SESSION=

# How many recent accepted submissions to scan each run (1 to 20;
# LeetCode returns at most the 20 most recent, so higher values are clamped)
SYNC_LIMIT=20
